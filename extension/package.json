{
  "name": "privacy-lint-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:chrome": "node scripts/build.mjs --browser=chrome",
    "build:firefox": "node scripts/build.mjs --browser=firefox",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "dev:firefox": "web-ext run --source-dir dist/firefox --target firefox-desktop",
    "dev:chrome": "web-ext run --source-dir dist/chrome --target chromium"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "esbuild": "^0.28.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "web-ext": "^10.7.0"
  },
  "dependencies": {
    "tldts": "^7.4.16"
  }
}
